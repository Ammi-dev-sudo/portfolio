# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: sqlite3 | mysql | postgresql
DB_ENGINE=sqlite3

# MySQL/PostgreSQL
DB_NAME=portfolio_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Cloudinary (stockage persistant des images en production)
# Laisse vide en local pour utiliser le dossier backend/media/.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternative : une seule variable au format cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_URL=
